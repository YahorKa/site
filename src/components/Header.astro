---
import { site, nav } from '../data/site';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="sticky top-0 z-50 border-b border-line/80 bg-paper/90 backdrop-blur">
  <div class="container-page flex h-16 items-center justify-between gap-4 sm:h-20">
    <a href="/" class="flex items-center gap-2.5" aria-label="Izo Studio — на главную">
      <img
        src="/icons/iconBlack.png"
        alt=""
        width="36"
        height="36"
        class="h-9 w-9 object-contain"
      />
      <span class="font-display text-xl tracking-tight">Izo Studio</span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Основная навигация">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'rounded-full px-4 py-2 text-sm transition-colors',
              isActive(item.href) ? 'bg-cream text-ink' : 'text-muted hover:text-ink',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a href={site.phoneHref} class="hidden text-sm font-medium hover:text-clay xl:block">
        {site.phone}
      </a>
      <a href="/zayavka" class="btn-primary hidden px-5 py-2.5 sm:inline-flex">Записаться</a>
      <button
        id="menu-toggle"
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-line lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Открыть меню"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M3 6h18M3 12h18M3 18h18" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-line bg-paper lg:hidden">
    <nav class="container-page flex flex-col py-3" aria-label="Мобильная навигация">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'rounded-xl px-3 py-3 text-base',
              isActive(item.href) ? 'bg-cream' : 'text-muted',
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a href="/zayavka" class="btn-primary mt-3">Записаться на занятие</a>
      <a href={site.phoneHref} class="mt-3 px-3 py-2 text-sm text-muted">{site.phone}</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!isOpen));
    toggle.setAttribute('aria-label', isOpen ? 'Открыть меню' : 'Закрыть меню');
    menu?.classList.toggle('hidden', isOpen);
  });
</script>
