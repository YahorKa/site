---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description = site.description, image = '/preview.png' } = Astro.props;

const siteUrl = Astro.site ?? new URL(site.url);
const canonical = new URL(Astro.url.pathname, siteUrl);
const ogImage = new URL(image, siteUrl);

const businessLd = {
  '@context': 'https://schema.org',
  '@type': ['EducationalOrganization', 'LocalBusiness'],
  name: 'Izo Studio',
  alternateName: 'Изостудия Izo Studio',
  description: site.description,
  url: siteUrl.href,
  telephone: '+375257187257',
  image: new URL('/preview.png', siteUrl).href,
  priceRange: '20–100 BYN',
  currenciesAccepted: 'BYN',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'ул. Деревянко, 3',
    addressLocality: 'Жодино',
    postalCode: '222160',
    addressCountry: 'BY',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 54.0938,
    longitude: 28.3213,
  },
  areaServed: { '@type': 'City', name: 'Жодино' },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '10:00',
      closes: '19:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Saturday', 'Sunday'],
      opens: '11:00',
      closes: '16:00',
    },
  ],
  sameAs: site.socials.map((s) => s.href),
};
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#fbf8f3" />
    <meta name="yandex-verification" content="82cbf7037bc30f57" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="120x120" href="/favicon-120.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(businessLd)} />

    <slot name="head" />

    {
      import.meta.env.PROD && (
        <>
          <script is:inline>
            (function (m, e, t, r, i, k, a) {
              m[i] = m[i] || function () { (m[i].a = m[i].a || []).push(arguments); };
              m[i].l = 1 * new Date();
              for (var j = 0; j < document.scripts.length; j++) {
                if (document.scripts[j].src === r) { return; }
              }
              k = e.createElement(t); a = e.getElementsByTagName(t)[0];
              k.async = 1; k.src = r; a.parentNode.insertBefore(k, a);
            })(window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js', 'ym');

            ym(103968612, 'init', {
              ssr: true,
              webvisor: true,
              clickmap: true,
              ecommerce: 'dataLayer',
              accurateTrackBounce: true,
              trackLinks: true,
            });
          </script>
          <noscript>
            <div>
              <img
                src="https://mc.yandex.ru/watch/103968612"
                style="position:absolute; left:-9999px"
                alt=""
              />
            </div>
          </noscript>
        </>
      )
    }
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

  </body>
</html>
