---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import faq from '../data/faq-detyam.json';
import { site, schedule, prices, teacher } from '../data/site';

const title = 'Рисование для детей в Жодино — группы 5–7 и 8–12 лет | Izo Studio';
const description =
  'Изостудия для детей 5–7 и 8–12 лет в Жодино: живопись, графика, лепка. Небольшие группы, занятия в будни и выходные. Абонемент 8 занятий — 100 руб.';

const ld = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://izostudio.by/' },
    { '@type': 'ListItem', position: 2, name: 'Детям', item: 'https://izostudio.by/detyam/' },
  ],
};
---

<Base title={title} description={description} image="/gallery/works/lisenok-zont.jpg">
  <section class="container-page grid gap-12 pt-10 pb-16 lg:grid-cols-[1.05fr_0.95fr] lg:items-center lg:pt-16 lg:pb-20">
    <div>
      <p class="eyebrow">Детям · 5–12 лет</p>
      <h1 class="mt-5 text-[2.6rem] leading-[1.0] sm:text-5xl lg:text-6xl">
        Рисование<br />
        <span class="italic text-clay">для детей</span><br />
        в Жодино
      </h1>
      <p class="mt-6 max-w-md text-base leading-relaxed text-muted">
        Занятия для детей 5–7 и 8–12 лет. Учимся видеть цвет и форму, работать с материалами и не
        бояться чистого листа — без оценок и давления.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/zayavka" class="btn-primary">Записаться на занятие</a>
        <a href="/gallery" class="btn-ghost">Работы учеников</a>
      </div>
      <dl class="mt-10 grid max-w-lg grid-cols-3 gap-6 border-t border-line pt-6">
        <div>
          <dt class="font-display text-2xl">с 5 лет</dt>
          <dd class="mt-1 text-xs leading-snug text-muted">возраст учеников</dd>
        </div>
        <div>
          <dt class="font-display text-2xl">до 8</dt>
          <dd class="mt-1 text-xs leading-snug text-muted">человек в группе</dd>
        </div>
        <div>
          <dt class="font-display text-2xl">100 руб</dt>
          <dd class="mt-1 text-xs leading-snug text-muted">абонемент 8 занятий</dd>
        </div>
      </dl>
    </div>

    <div class="overflow-hidden rounded-[2rem] border border-line">
      <img
        src="/gallery/works/prividenie-mella.jpg"
        alt="Работа ученика изостудии в Жодино — привидение на метле, гуашь"
        width="896"
        height="1120"
        class="aspect-4/5 w-full object-cover"
      />
    </div>
  </section>

  <section class="border-y border-line bg-cream/40">
    <div class="container-page py-16 lg:py-20">
      <p class="eyebrow">Группы</p>
      <h2 class="mt-3 max-w-2xl text-3xl sm:text-4xl">Два возраста — разные задачи</h2>
      <p class="mt-4 max-w-xl text-sm leading-relaxed text-muted">
        Дошкольникам важно попробовать материалы и не испугаться листа. Школьникам — уже ставить руку
        и доводить работу до конца.
      </p>

      <div class="mt-10 grid gap-4 md:grid-cols-2">
        <article class="rounded-2xl border border-line bg-paper p-7">
          <span class="rounded-full border border-line px-3 py-1 text-xs text-muted">5–7 лет</span>
          <h3 class="mt-4 text-2xl">Первые шаги</h3>
          <ul class="mt-4 space-y-2 text-sm leading-relaxed text-muted">
            <li>— крупные формы и простые композиции;</li>
            <li>— гуашь, акварель, пастель, пластилин;</li>
            <li>— короткие задания, чтобы не терять внимание;</li>
            <li>— педагог помогает на каждом этапе.</li>
          </ul>
        </article>

        <article class="rounded-2xl border border-line bg-paper p-7">
          <span class="rounded-full border border-line px-3 py-1 text-xs text-muted">8–12 лет</span>
          <h3 class="mt-4 text-2xl">Уверенная рука</h3>
          <ul class="mt-4 space-y-2 text-sm leading-relaxed text-muted">
            <li>— пропорции, светотень, построение;</li>
            <li>— работа с натуры и по представлению;</li>
            <li>— более длинные работы, доведённые до конца;</li>
            <li>— лучшие работы показываем в галерее студии.</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <section class="container-page py-16 lg:py-20">
    <p class="eyebrow">Как проходит занятие</p>
    <h2 class="mt-3 max-w-xl text-3xl sm:text-4xl">Никаких «правильно» и «неправильно»</h2>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      <article class="rounded-2xl border border-line p-6">
        <span class="font-display text-3xl text-clay">01</span>
        <h3 class="mt-4 text-xl">Разминка и тема</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted">Смотрим примеры, обсуждаем, что будем рисовать и какими материалами.</p>
      </article>
      <article class="rounded-2xl border border-line p-6">
        <span class="font-display text-3xl text-clay">02</span>
        <h3 class="mt-4 text-xl">Работа</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted">Каждый рисует свою работу. Педагог подходит, подсказывает и показывает приёмы.</p>
      </article>
      <article class="rounded-2xl border border-line p-6">
        <span class="font-display text-3xl text-clay">03</span>
        <h3 class="mt-4 text-xl">Разбор</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted">Смотрим, что получилось, хвалим за конкретное — за цвет, композицию, смелость.</p>
      </article>
    </div>
  </section>

  <section class="border-y border-line bg-cream/40">
    <div class="container-page grid gap-10 py-14 lg:grid-cols-2 lg:py-16">
      <div>
        <p class="eyebrow">Расписание</p>
        <h2 class="mt-3 text-3xl">Когда занимаемся</h2>
        <ul class="mt-6 divide-y divide-line border-y border-line">
          {schedule.map((s) => (
            <li class="flex items-baseline justify-between gap-4 py-4">
              <span class="text-base text-muted">{s.days}</span>
              <span class="font-display text-2xl">{s.time}</span>
            </li>
          ))}
        </ul>
        <p class="mt-4 text-xs text-muted">Это действующие группы — в них есть свободные места.</p>
      </div>
      <div>
        <p class="eyebrow">Стоимость</p>
        <h2 class="mt-3 text-3xl">Цены</h2>
        <div class="mt-6 space-y-3">
          {prices.map((p) => (
            <div class="flex items-center justify-between gap-4 rounded-2xl border border-line bg-paper p-5">
              <div>
                <p class="text-base">{p.title}</p>
                <p class="mt-1 text-xs text-muted">{p.detail}</p>
              </div>
              <p class="whitespace-nowrap font-display text-2xl">{p.price}</p>
            </div>
          ))}
        </div>
        <p class="mt-4 text-xs leading-relaxed text-muted">
          На первое занятие материалы приносить не нужно — всё есть в студии.
        </p>
      </div>
    </div>
  </section>

  <section class="container-page py-16 lg:py-20">
    <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-center">
      <div class="overflow-hidden rounded-[2rem] border border-line">
        <img
          src={teacher.photo}
          alt={`${teacher.name} — преподаватель изостудии в Жодино`}
          width="700"
          height="875"
          class="aspect-4/5 w-full object-cover"
          loading="lazy"
        />
      </div>
      <div>
        <p class="eyebrow">Педагог</p>
        <h2 class="mt-3 text-3xl sm:text-4xl">{teacher.name}</h2>
        <p class="mt-2 text-sm text-muted">{teacher.role}</p>
        <p class="mt-6 max-w-xl text-base leading-relaxed text-muted">{teacher.bio}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/about" class="btn-ghost">О студии</a>
          <a href="/gallery" class="btn-ghost">Смотреть работы</a>
        </div>
      </div>
    </div>
  </section>

  <Faq items={faq} title="Вопросы родителей" />

  <section class="container-page pb-20">
    <div class="rounded-[2rem] border border-line bg-cream px-6 py-12 text-center sm:px-12 sm:py-16">
      <h2 class="mx-auto mt-3 max-w-2xl text-3xl sm:text-4xl">Запишите ребёнка на первое занятие</h2>
      <p class="mx-auto mt-4 max-w-md text-sm leading-relaxed text-muted">
        Оставьте заявку или позвоните: {site.phone}
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/zayavka" class="btn-primary">Оставить заявку</a>
        <a href={site.phoneHref} class="btn-ghost">Позвонить</a>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</Base>
