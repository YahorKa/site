---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import { services, site, schedule, prices } from '../data/site';
---

<Base
  title="Занятия и форматы обучения — Izo Studio, Жодино"
  description="Групповые и индивидуальные занятия рисованием в Жодино, мастер-классы, онлайн-обучение и арт-мероприятия. Запись в изостудию Izo Studio."
>
  <section class="container-page pt-12 pb-10 lg:pt-20">
    <p class="eyebrow">Занятия</p>
    <h1 class="mt-4 max-w-3xl text-4xl leading-[1.05] sm:text-5xl lg:text-6xl">
      Форматы обучения
    </h1>
    <p class="mt-5 max-w-xl text-base leading-relaxed text-muted">
      Можно заниматься в группе, индивидуально или прийти на короткий мастер-класс. Подберём формат
      под возраст, уровень и расписание.
    </p>
  </section>

  <section class="container-page pb-16">
    <div class="grid gap-4 md:grid-cols-2">
      {
        services.map((s, i) => (
          <article class:list={['rounded-2xl border border-line p-7', i === 0 ? 'bg-cream/60 md:col-span-2' : 'bg-white/40']}>
            <div class="flex items-start justify-between gap-4">
              <h2 class="text-2xl">{s.title}</h2>
              <span class="shrink-0 rounded-full border border-line px-3 py-1 text-xs text-muted">
                {s.meta}
              </span>
            </div>
            <p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted">{s.text}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="container-page py-14 lg:py-16">
    <div class="grid gap-4 md:grid-cols-2">
      <a href="/detyam" class="group rounded-2xl border border-line bg-cream/50 p-7 transition-colors hover:border-ink/25">
        <p class="eyebrow">Детям</p>
        <h2 class="mt-3 text-2xl">Рисование для детей 5–12 лет</h2>
        <p class="mt-2 text-sm leading-relaxed text-muted">Группы 5–7 и 8–12 лет: от первых материалов до уверенной руки.</p>
        <span class="mt-4 inline-block text-sm text-ink underline decoration-line underline-offset-4">Подробнее →</span>
      </a>
      <a href="/vzroslym" class="group rounded-2xl border border-line bg-cream/50 p-7 transition-colors hover:border-ink/25">
        <p class="eyebrow">Взрослым</p>
        <h2 class="mt-3 text-2xl">Рисование для взрослых</h2>
        <p class="mt-2 text-sm leading-relaxed text-muted">Вечерняя группа до 8 человек, в том числе с нуля.</p>
        <span class="mt-4 inline-block text-sm text-ink underline decoration-line underline-offset-4">Подробнее →</span>
      </a>
    </div>
  </section>

  <section class="border-y border-line bg-cream/40">
    <div class="container-page py-14 lg:py-16">
      <div class="grid gap-12 lg:grid-cols-2">
        <div>
          <p class="eyebrow">Расписание</p>
          <h2 class="mt-3 text-3xl">Расписание групп</h2>
          <ul class="mt-6 divide-y divide-line border-y border-line">
            {
              schedule.map((s) => (
                <li class="flex items-baseline justify-between gap-4 py-4">
                  <span class="text-base text-muted">{s.days}</span>
                  <span class="font-display text-2xl">{s.time}</span>
                </li>
              ))
            }
          </ul>
          <p class="mt-4 text-xs leading-relaxed text-muted">
            Это действующие группы, в них есть свободные места.
          </p>
        </div>

        <div>
          <p class="eyebrow">Стоимость</p>
          <h2 class="mt-3 text-3xl">Цены</h2>
          <div class="mt-6 space-y-3">
            {
              prices.map((p) => (
                <div class="flex items-center justify-between gap-4 rounded-2xl border border-line bg-paper p-5">
                  <div>
                    <p class="text-base">{p.title}</p>
                    <p class="mt-1 text-xs text-muted">{p.detail}</p>
                  </div>
                  <p class="whitespace-nowrap font-display text-2xl">{p.price}</p>
                </div>
              ))
            }
          </div>
          <p class="mt-4 text-xs leading-relaxed text-muted">
            Оплата в студии. Материалы на первые занятия приносить не нужно — расскажем, что
            понадобится дальше.
          </p>
        </div>
      </div>
    </div>
  </section>

  <Faq title="Вопросы о занятиях" />

  <section class="container-page py-16 text-center">
    <h2 class="mx-auto max-w-xl text-3xl sm:text-4xl">Не знаете, что выбрать?</h2>
    <p class="mx-auto mt-4 max-w-md text-sm leading-relaxed text-muted">
      Оставьте заявку — обсудим направление и подберём формат. Или позвоните: {site.phone}
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/zayavka" class="btn-primary">Оставить заявку</a>
      <a href={site.phoneHref} class="btn-ghost">Позвонить</a>
    </div>
  </section>
</Base>
