---
import Base from '../layouts/Base.astro';
import { site, directions, gallery, steps, teacher, schedule, prices } from '../data/site';
---

<Base title="Изостудия в Жодино — живопись, графика, лепка | Izo Studio">
  <!-- Hero -->
  <section class="container-page grid gap-12 pt-10 pb-16 lg:grid-cols-[1.05fr_0.95fr] lg:items-center lg:pt-16 lg:pb-24">
    <div>
      <p class="eyebrow">Жодино · Дворец культуры</p>
      <h1 class="mt-5 text-[2.75rem] leading-[0.95] sm:text-6xl lg:text-7xl">
        Изостудия<br />
        <span class="italic text-clay">в Жодино</span>
      </h1>
      <p class="mt-6 max-w-md text-base leading-relaxed text-muted">
        Живопись, графика, лепка и декоративное искусство для детей и взрослых. Без формализма и
        давления — с вниманием к каждому.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/zayavka" class="btn-primary">Записаться на занятие</a>
        <a href="/gallery" class="btn-ghost">Смотреть работы</a>
      </div>

      <dl class="mt-10 grid max-w-lg grid-cols-3 gap-6 border-t border-line pt-6">
        <div>
          <dt class="font-display text-2xl">10+ лет</dt>
          <dd class="mt-1 text-xs leading-snug text-muted">педагогического опыта</dd>
        </div>
        <div>
          <dt class="font-display text-2xl">{directions.length}</dt>
          <dd class="mt-1 text-xs leading-snug text-muted">направления обучения</dd>
        </div>
        <div>
          <dt class="font-display text-2xl">{gallery.length}</dt>
          <dd class="mt-1 text-xs leading-snug text-muted">работ в галерее</dd>
        </div>
      </dl>
    </div>

    <div class="relative">
      <div class="overflow-hidden rounded-[2rem] border border-line">
        <img
          src="/gallery/preview2.jpg"
          alt="Работа ученика изостудии Izo Studio в Жодино"
          width="800"
          height="1000"
          class="aspect-4/5 w-full object-cover"
          fetchpriority="high"
        />
      </div>
      <div class="absolute -bottom-6 -left-4 hidden w-52 rounded-2xl border border-line bg-paper p-5 sm:block">
        <p class="font-display text-lg leading-tight">Начнём со знакомства</p>
        <p class="mt-1.5 text-xs leading-relaxed text-muted">
          Подберём направление, группу и удобное время
        </p>
      </div>
    </div>
  </section>

  <!-- Directions -->
  <section class="border-y border-line bg-cream/40">
    <div class="container-page py-16 lg:py-20">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="eyebrow">Направления</p>
          <h2 class="mt-3 text-3xl sm:text-4xl">Чему учимся</h2>
        </div>
        <a href="/services" class="text-sm text-muted underline decoration-line underline-offset-4 transition-colors hover:text-ink">
          Все занятия и форматы →
        </a>
      </div>

      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          directions.map((d) => (
            <article class="group rounded-2xl border border-line bg-paper p-6 transition-colors hover:border-ink/25">
              <h3 class="text-2xl">{d.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-muted">{d.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Schedule & prices -->
  <section class="container-page py-16 lg:py-20">
    <div class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
      <div>
        <p class="eyebrow">Расписание</p>
        <h2 class="mt-3 text-3xl sm:text-4xl">Когда занимаемся</h2>
        <ul class="mt-8 divide-y divide-line border-y border-line">
          {
            schedule.map((s) => (
              <li class="flex items-baseline justify-between gap-4 py-4">
                <span class="text-base text-muted">{s.days}</span>
                <span class="font-display text-2xl">{s.time}</span>
              </li>
            ))
          }
        </ul>
        <p class="mt-4 text-xs text-muted">Свободные места уточняйте при записи.</p>
      </div>

      <div class="rounded-[2rem] border border-line bg-cream p-7 sm:p-8">
        <p class="eyebrow">Стоимость</p>
        <div class="mt-6 space-y-4">
          {
            prices.map((p) => (
              <div class="flex items-baseline justify-between gap-4">
                <div>
                  <p class="text-sm font-medium">{p.title}</p>
                  <p class="mt-0.5 text-xs text-muted">{p.detail}</p>
                </div>
                <p class="whitespace-nowrap font-display text-2xl">{p.price}</p>
              </div>
            ))
          }
        </div>
        <a href="/zayavka" class="btn-primary mt-7 w-full">Записаться</a>
      </div>
    </div>
  </section>

  <!-- Teacher -->
  <section class="container-page py-16 lg:py-24">
    <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-center">
      <div class="overflow-hidden rounded-[2rem] border border-line">
        <img
          src={teacher.photo}
          alt={`${teacher.name} — преподаватель изостудии`}
          width="700"
          height="875"
          class="aspect-4/5 w-full object-cover"
          loading="lazy"
        />
      </div>
      <div>
        <p class="eyebrow">Преподаватель</p>
        <h2 class="mt-3 text-3xl sm:text-4xl">{teacher.name}</h2>
        <p class="mt-2 text-sm text-muted">{teacher.role}</p>
        <p class="mt-6 max-w-xl text-base leading-relaxed text-muted">{teacher.bio}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/about" class="btn-ghost">Подробнее о студии</a>
          <a href={teacher.instagram} target="_blank" rel="noopener noreferrer" class="btn-ghost">
            Работы в Instagram
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Gallery strip -->
  <section class="border-y border-line bg-ink text-paper">
    <div class="container-page py-16 lg:py-20">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="eyebrow text-paper/50">Галерея</p>
          <h2 class="mt-3 text-3xl sm:text-4xl">Работы учеников</h2>
        </div>
        <a href="/gallery" class="text-sm text-paper/60 underline decoration-paper/20 underline-offset-4 transition-colors hover:text-paper">
          Смотреть все работы →
        </a>
      </div>
    </div>

    <div class="marquee mt-10 pb-16 lg:pb-20" data-marquee>
      <div class="marquee-track flex w-max" data-marquee-track>
        {
          [0, 1].map((copy) => (
            <div class="flex shrink-0 gap-3 pr-3" aria-hidden={copy === 1 ? 'true' : undefined}>
              {gallery.map((item) => (
                <a
                  href="/gallery"
                  tabindex={copy === 1 ? -1 : undefined}
                  draggable="false"
                  class="group shrink-0 overflow-hidden rounded-xl border border-paper/10"
                >
                  <img
                    src={item.src}
                    alt={copy === 1 ? '' : item.alt}
                    width="576"
                    height="416"
                    draggable="false"
                    loading="lazy"
                    class="h-40 w-56 object-cover transition-transform duration-500 group-hover:scale-105 sm:h-52 sm:w-72"
                  />
                </a>
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Steps -->
  <section class="container-page py-16 lg:py-24">
    <p class="eyebrow">Как начать</p>
    <h2 class="mt-3 max-w-xl text-3xl sm:text-4xl">Три шага до первого занятия</h2>

    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {
        steps.map((s) => (
          <article class="rounded-2xl border border-line p-6">
            <span class="font-display text-3xl text-clay">{s.n}</span>
            <h3 class="mt-4 text-xl">{s.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{s.text}</p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- CTA -->
  <section class="container-page pb-20">
    <div class="rounded-[2rem] border border-line bg-cream px-6 py-12 text-center sm:px-12 sm:py-16">
      <p class="eyebrow">Запись</p>
      <h2 class="mx-auto mt-3 max-w-2xl text-3xl sm:text-4xl">
        Расскажите, чем хотите заниматься — подберём группу и время
      </h2>
      <p class="mx-auto mt-4 max-w-md text-sm leading-relaxed text-muted">
        Оставьте заявку или позвоните: {site.phone}
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/zayavka" class="btn-primary">Оставить заявку</a>
        <a href={site.phoneHref} class="btn-ghost">Позвонить</a>
      </div>
    </div>
  </section>
  <script>
    const scroller = document.querySelector('[data-marquee]');
    const track = scroller?.querySelector('[data-marquee-track]');

    if (scroller && track) {
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const SPEED = 0.6; // px за кадр при автопрокрутке
      let paused = false;
      let resumeTimer: ReturnType<typeof setTimeout> | undefined;

      const half = () => track.scrollWidth / 2;

      const wrap = () => {
        const h = half();
        if (!h) return;
        if (scroller.scrollLeft >= h) scroller.scrollLeft -= h;
        else if (scroller.scrollLeft < 0) scroller.scrollLeft += h;
      };

      const tick = () => {
        if (!paused && !reduceMotion.matches) {
          scroller.scrollLeft += SPEED;
          wrap();
        }
        requestAnimationFrame(tick);
      };

      const pause = () => {
        paused = true;
        clearTimeout(resumeTimer);
      };

      const resume = (delay = 0) => {
        clearTimeout(resumeTimer);
        resumeTimer = setTimeout(() => {
          paused = false;
        }, delay);
      };

      requestAnimationFrame(tick);

      scroller.addEventListener('mouseenter', pause);
      scroller.addEventListener('mouseleave', () => resume(500));
      scroller.addEventListener('focusin', pause);
      scroller.addEventListener('focusout', () => resume(500));

      // Прокрутка колесом/тачпадом — нативная, только ставим на паузу.
      scroller.addEventListener(
        'wheel',
        () => {
          pause();
          resume(1500);
        },
        { passive: true },
      );

      scroller.addEventListener('touchstart', pause, { passive: true });
      scroller.addEventListener('touchend', () => resume(1500), { passive: true });

      // Перетаскивание мышью (без pointer capture, чтобы не ломать клики по ссылкам).
      let dragging = false;
      let startX = 0;
      let startScroll = 0;
      let moved = false;

      const onPointerDown = (event: PointerEvent) => {
        if (event.pointerType !== 'mouse' || event.button !== 0) return;
        dragging = true;
        moved = false;
        startX = event.clientX;
        startScroll = scroller.scrollLeft;
        scroller.classList.add('marquee--dragging');
        pause();
      };

      const onPointerMove = (event: PointerEvent) => {
        if (!dragging) return;
        const dx = event.clientX - startX;
        if (Math.abs(dx) > 4) moved = true;
        scroller.scrollLeft = startScroll - dx;
        wrap();
      };

      const endDrag = () => {
        if (!dragging) return;
        dragging = false;
        scroller.classList.remove('marquee--dragging');
        resume(900);
      };

      scroller.addEventListener('pointerdown', onPointerDown);
      window.addEventListener('pointermove', onPointerMove);
      window.addEventListener('pointerup', endDrag);
      window.addEventListener('pointercancel', endDrag);

      // После перетаскивания не переходим по ссылке.
      scroller.addEventListener(
        'click',
        (event: MouseEvent) => {
          if (moved) {
            event.preventDefault();
            event.stopPropagation();
            moved = false;
          }
        },
        true,
      );

      document.addEventListener('visibilitychange', () => {
        paused = document.hidden;
      });
    }
  </script>
</Base>
