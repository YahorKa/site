---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base
  title="Контакты — изостудия в Жодино, ул. Деревянко 3 | Izo Studio"
  description="Адрес изостудии Izo Studio: г. Жодино, ул. Деревянко, 3 (Дворец культуры). Телефон +375 (25) 718-72-57, email info@izostudio.by."
>
  <section class="container-page pt-12 pb-10 lg:pt-20">
    <p class="eyebrow">Контакты</p>
    <h1 class="mt-4 text-4xl leading-[1.05] sm:text-5xl lg:text-6xl">Как нас найти</h1>
  </section>

  <section class="container-page grid gap-10 pb-16 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
    <div class="space-y-8">
      <div>
        <h2 class="text-sm font-medium uppercase tracking-wider text-muted">Адрес</h2>
        <p class="mt-3 text-xl">{site.address}</p>
        <p class="text-muted">{site.addressNote}</p>
      </div>

      <div class="grid gap-6 sm:grid-cols-2">
        <div>
          <h2 class="text-sm font-medium uppercase tracking-wider text-muted">Телефон</h2>
          <p class="mt-3">
            <a href={site.phoneHref} class="text-xl hover:text-clay">{site.phone}</a>
          </p>
        </div>
        <div>
          <h2 class="text-sm font-medium uppercase tracking-wider text-muted">Email</h2>
          <p class="mt-3">
            <a href={`mailto:${site.email}`} class="text-xl hover:text-clay">{site.email}</a>
          </p>
        </div>
      </div>

      <div>
        <h2 class="text-sm font-medium uppercase tracking-wider text-muted">Часы работы</h2>
        <ul class="mt-3 space-y-1 text-muted">
          {site.hours.map((h) => <li>{h.days}: {h.time}</li>)}
        </ul>
      </div>

      <div>
        <h2 class="text-sm font-medium uppercase tracking-wider text-muted">Мы в соцсетях</h2>
        <div class="mt-3 flex flex-wrap gap-3">
          {
            site.socials.map((s) => (
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 rounded-full border border-line px-4 py-2 text-sm transition-colors hover:border-ink/30"
              >
                <img src={s.icon} alt="" width="16" height="16" class="h-4 w-4" />
                {s.label}
              </a>
            ))
          }
        </div>
      </div>

      <div class="flex flex-wrap gap-3 pt-2">
        <a href="/zayavka" class="btn-primary">Записаться на занятие</a>
        <a href={site.phoneHref} class="btn-ghost">Позвонить</a>
      </div>
    </div>

    <div class="overflow-hidden rounded-[1.5rem] border border-line">
      <iframe
        src={site.mapSrc}
        title="Изостудия Izo Studio на карте — Жодино, ул. Деревянко, 3"
        width="100%"
        height="520"
        loading="lazy"
        style="border:0"
      ></iframe>
    </div>
  </section>
</Base>
