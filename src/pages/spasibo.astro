---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base title="Заявка отправлена — Izo Studio" description="Спасибо! Мы свяжемся с вами в ближайшее время.">
  <section class="container-page flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
    <p class="eyebrow">Готово</p>
    <h1 class="mt-4 max-w-xl text-4xl leading-tight sm:text-5xl">Заявка отправлена</h1>
    <p class="mt-5 max-w-md text-base leading-relaxed text-muted">
      Спасибо! Мы свяжемся с вами в ближайшее время, чтобы уточнить детали и подобрать группу.
    </p>
    <p class="mt-3 text-sm text-muted">
      Если срочно — звоните: <a href={site.phoneHref} class="text-ink hover:text-clay">{site.phone}</a>
    </p>
    <a href="/" class="btn-primary mt-8">На главную</a>
  </section>

  <script>
    // Цель «заявка»: страница открывается только после успешной отправки формы
    window.addEventListener('load', () => {
      const ym = (window as unknown as { ym?: (...args: unknown[]) => void }).ym;
      if (typeof ym === 'function') ym(103968612, 'reachGoal', 'zayavka');
    });
  </script>
</Base>
