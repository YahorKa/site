---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base
  title="Запись на занятие — Izo Studio, Жодино"
  description="Онлайн-заявка в изостудию Izo Studio в Жодино: укажите имя, возраст и направление — подберём группу и время."
>
  <section class="container-page grid gap-12 pt-12 pb-20 lg:grid-cols-[0.85fr_1.15fr] lg:pt-20">
    <div>
      <p class="eyebrow">Запись</p>
      <h1 class="mt-4 text-4xl leading-[1.05] sm:text-5xl">Заявка на занятие</h1>
      <p class="mt-5 max-w-sm text-base leading-relaxed text-muted">
        Заполните форму — мы свяжемся, уточним детали и подберём удобное время. Заявка ни к чему не
        обязывает.
      </p>

      <div class="mt-8 space-y-3 text-sm text-muted">
        <p>Не хотите заполнять форму? Позвоните:</p>
        <p><a href={site.phoneHref} class="text-lg text-ink hover:text-clay">{site.phone}</a></p>
        <p>Или напишите в <a href="https://t.me/nastasia1313" target="_blank" rel="noopener noreferrer" class="text-ink underline decoration-line underline-offset-4 hover:text-clay">Telegram</a>.</p>
      </div>
    </div>

    <form
      id="zayavka-form"
      name="zayavka"
      method="POST"
      action="/.netlify/functions/zayavka"
      class="rounded-[1.5rem] border border-line bg-white/50 p-6 sm:p-8"
    >
      <div
        id="form-error"
        class="mb-5 hidden rounded-xl border border-clay/30 bg-clay/5 px-4 py-3 text-sm text-clay"
        role="alert"
      >
        Не получилось отправить заявку. Проверьте номер телефона или позвоните нам.
      </div>

      <p class="hidden">
        <label>Не заполняйте это поле: <input name="bot-field" /></label>
      </p>

      <fieldset class="mb-6">
        <legend class="label">Кто будет заниматься</legend>
        <div class="grid grid-cols-2 gap-2">
          <label class="cursor-pointer rounded-xl border border-line bg-white/60 px-4 py-3 text-center text-sm transition-colors has-checked:border-ink has-checked:bg-cream">
            <input type="radio" name="student_type" value="child" checked class="sr-only" />
            Ребёнок
          </label>
          <label class="cursor-pointer rounded-xl border border-line bg-white/60 px-4 py-3 text-center text-sm transition-colors has-checked:border-ink has-checked:bg-cream">
            <input type="radio" name="student_type" value="adult" class="sr-only" />
            Взрослый
          </label>
        </div>
      </fieldset>

      <div class="grid gap-5 sm:grid-cols-2">
        <div id="parent-field">
          <label class="label" for="parent_name">Имя родителя</label>
          <input class="field" id="parent_name" type="text" name="parent_name" required autocomplete="name" />
        </div>

        <div>
          <label class="label" for="child_name" id="child-label">Имя ученика</label>
          <input class="field" id="child_name" type="text" name="child_name" required />
        </div>

        <div>
          <label class="label" for="child_age" id="age-label">Возраст</label>
          <input class="field" id="child_age" type="number" name="child_age" min="3" max="99" required />
        </div>

        <div>
          <label class="label" for="direction">Направление</label>
          <select class="field" id="direction" name="direction" required>
            <option value="" disabled selected>Выберите</option>
            <option>Живопись</option>
            <option>Графика</option>
            <option>Лепка</option>
            <option>Декоративное искусство</option>
            <option>Не знаю — подскажите</option>
          </select>
        </div>

        <div class="sm:col-span-2">
          <label class="label" for="phone">Телефон</label>
          <div class="flex items-stretch overflow-hidden rounded-xl border border-line bg-white/70 focus-within:border-ink/40 focus-within:bg-white">
            <span class="flex select-none items-center border-r border-line px-4 text-sm text-muted">+375</span>
            <input
              class="w-full bg-transparent px-4 py-3 text-sm outline-none"
              id="phone"
              type="tel"
              name="phone"
              required
              autocomplete="tel-national"
              inputmode="numeric"
              maxlength="12"
              placeholder="25 718-72-57"
              aria-describedby="phone-hint"
            />
          </div>
          <p id="phone-hint" class="mt-1.5 text-xs text-muted">
            Код оператора 25, 29, 33 или 44 — например, 25 718-72-57
          </p>
          <p id="phone-error" class="mt-1.5 hidden text-xs text-clay">
            Проверьте номер: 9 цифр, код оператора 25, 29, 33 или 44.
          </p>
        </div>

        <div class="sm:col-span-2">
          <label class="label" for="comment">Комментарий</label>
          <textarea class="field min-h-28 resize-y" id="comment" name="comment" rows="4" placeholder="Удобные дни и время, опыт, вопросы"></textarea>
        </div>
      </div>

      <label class="mt-6 flex items-start gap-3 text-xs leading-relaxed text-muted">
        <input type="checkbox" name="consent" required class="mt-0.5 h-4 w-4 accent-ink" />
        <span>
          Согласен на обработку персональных данных для связи по заявке.
        </span>
      </label>

      <button id="submit-btn" type="submit" class="btn-primary mt-6 w-full sm:w-auto">
        Отправить заявку
      </button>
      <p id="form-sending" class="mt-3 hidden text-xs text-muted">Отправляем заявку…</p>
    </form>
  </section>

  <script>
    const form = document.getElementById('zayavka-form') as HTMLFormElement | null;
    const phone = document.getElementById('phone') as HTMLInputElement | null;
    const phoneError = document.getElementById('phone-error');
    const formError = document.getElementById('form-error');
    const sending = document.getElementById('form-sending');
    const button = document.getElementById('submit-btn') as HTMLButtonElement | null;

    // Переключатель «ребёнок / взрослый»
    const studentRadios = form ? [...form.querySelectorAll('input[name="student_type"]')] : [];
    const parentField = document.getElementById('parent-field');
    const parentInput = document.getElementById('parent_name') as HTMLInputElement | null;
    const childLabel = document.getElementById('child-label');
    const ageLabel = document.getElementById('age-label');
    const ageInput = document.getElementById('child_age') as HTMLInputElement | null;

    function applyStudentType(type: string) {
      const isAdult = type === 'adult';
      parentField?.classList.toggle('hidden', isAdult);
      if (parentInput) parentInput.required = !isAdult;
      if (childLabel) childLabel.textContent = isAdult ? 'Ваше имя' : 'Имя ученика';
      if (ageLabel) ageLabel.textContent = isAdult ? 'Возраст (необязательно)' : 'Возраст';
      if (ageInput) ageInput.required = !isAdult;
    }

    studentRadios.forEach((radio) => {
      radio.addEventListener('change', () => applyStudentType((radio as HTMLInputElement).value));
    });
    applyStudentType('child');

    // Белорусские коды операторов
    const CODES = ['25', '29', '33', '44'];
    const isValidPhone = (value: string) => {
      const digits = value.replace(/\D/g, '');
      return /^\d{9}$/.test(digits) && CODES.includes(digits.slice(0, 2));
    };

    // Показываем баннер, если сервер вернул сюда после неудачной проверки
    if (new URLSearchParams(location.search).get('error') === 'phone') {
      formError?.classList.remove('hidden');
      phoneError?.classList.remove('hidden');
    }

    // Лёгкое форматирование: 25 718-72-57
    phone?.addEventListener('input', () => {
      const digits = phone.value.replace(/\D/g, '').slice(0, 9);
      let out = digits;
      if (digits.length > 2) out = `${digits.slice(0, 2)} ${digits.slice(2)}`;
      if (digits.length > 5) out = `${digits.slice(0, 2)} ${digits.slice(2, 5)}-${digits.slice(5)}`;
      if (digits.length > 7) out = `${digits.slice(0, 2)} ${digits.slice(2, 5)}-${digits.slice(5, 7)}-${digits.slice(7)}`;
      phone.value = out;
      phoneError?.classList.add('hidden');
    });

    let isSending = false;

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (isSending) return;

      if (!phone || !isValidPhone(phone.value)) {
        phoneError?.classList.remove('hidden');
        phone?.focus();
        return;
      }

      isSending = true;
      formError?.classList.add('hidden');
      sending?.classList.remove('hidden');
      if (button) {
        button.disabled = true;
        button.textContent = 'Отправляем…';
      }

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { 'content-type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(new FormData(form) as unknown as Record<string, string>),
          redirect: 'follow',
        });

        // Функция отвечает редиректом: /spasibo — успех, /oshibka — сбой
        if (response.url.includes('/spasibo')) {
          location.assign('/spasibo');
          return;
        }

        throw new Error('server rejected');
      } catch {
        formError?.classList.remove('hidden');
        sending?.classList.add('hidden');
        isSending = false;
        if (button) {
          button.disabled = false;
          button.textContent = 'Отправить заявку';
        }
      }
    });
  </script>
</Base>
